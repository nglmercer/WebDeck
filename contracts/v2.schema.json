{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webdeck.local/contracts/v2",
  "$defs": {
    "Capability": {
      "type": "string",
      "enum": [
        "read",
        "input",
        "audio",
        "window",
        "power",
        "script",
        "network",
        "plugin",
        "admin",
        "settings"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unsupported_schema",
        "conflict",
        "unauthorized",
        "forbidden",
        "capacity_exhausted",
        "shutting_down",
        "unknown_command",
        "execution_failed",
        "persistence_failed"
      ]
    },
    "CommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 65536
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:.\\-]+$"
        }
      },
      "required": [
        "message"
      ]
    },
    "ConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "revision",
        "config"
      ]
    },
    "DeviceRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "name",
        "capabilities",
        "ttl_seconds"
      ]
    },
    "CommandAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:.\\-]+$"
        },
        "state": {
          "const": "accepted"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "state"
      ]
    },
    "CommandCompleted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:.\\-]+$"
        },
        "state": {
          "const": "completed"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "state",
        "result"
      ]
    },
    "CommandFailed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:.\\-]+$"
        },
        "state": {
          "const": "failed"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "state",
        "code",
        "message"
      ]
    },
    "ConfigResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "api_version",
        "revision",
        "config"
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "expires_at": {
          "type": "integer"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "expires_at",
        "revoked"
      ]
    },
    "DeviceApproval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "device": {
          "$ref": "#/$defs/Device"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "device",
        "token"
      ]
    },
    "DeviceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        }
      },
      "required": [
        "api_version",
        "devices"
      ]
    },
    "DeviceRevocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 2
        },
        "revoked": {
          "const": true
        }
      },
      "required": [
        "api_version",
        "revoked"
      ]
    }
  }
}
